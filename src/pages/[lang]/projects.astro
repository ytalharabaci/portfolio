---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { LANGS, type Lang } from "../../config/site";
import { PROJECTS, PROJECT_CATEGORIES, type ProjectCategory } from "../../data/projects";
import { getStaticPage } from "../../lib/content";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const projectPage = getStaticPage(lang, "projects");
const title = projectPage?.title ?? (lang === "tr" ? "Projeler" : "Projects");
const groups = (Object.keys(PROJECT_CATEGORIES) as ProjectCategory[])
  .map((category) => ({ category, projects: PROJECTS.filter((project) => project.category === category) }))
  .filter((group) => group.projects.length > 0);
---

<BaseLayout title={title} lang={lang} description={projectPage?.description}>
  <header class="page-header">
    <h1 class="title">{title}</h1>
  </header>

  {groups.map(({ category, projects }) => (
    <section aria-labelledby={`projects-${category}`}>
      <h2 class="section-title" id={`projects-${category}`}>{PROJECT_CATEGORIES[category][lang]}</h2>
      <div class="projects-grid">
        {projects.map((project) => <ProjectCard project={project} lang={lang} headingLevel={3} />)}
      </div>
    </section>
  ))}
</BaseLayout>
