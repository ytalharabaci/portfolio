---
import ArticlePage from "../../../components/ArticlePage.astro";
import { LANGS, type Lang } from "../../../config/site";
import { getEntriesByLang, getPostSlug, isPostEntry, type ContentEntry } from "../../../lib/content";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getEntriesByLang(lang)
      .filter(isPostEntry)
      .map((post) => ({ params: { lang, slug: getPostSlug(post) }, props: { lang, post } })),
  );
}

const { post, lang } = Astro.props as { post: ContentEntry; lang: Lang };
---

<ArticlePage entry={post} lang={lang} tocDepth={2} />
